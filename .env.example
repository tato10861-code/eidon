# ---------------------------------------------------------------------------
# Eidon — environment
# Everything is optional. With no keys the app runs on the built-in
# deterministic demo engine, so local development and previews always work.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI provider — priority order (first configured key wins):
#   1. Anthropic  2. OpenRouter  3. Gemini  4. Mistral  5. Cohere  6. xAI  7. AI71  8. OpenAI
# ---------------------------------------------------------------------------

# 1. Anthropic Claude (best quality; recommended for production)
#    Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# 2. OpenRouter — 100+ models via one key; great for multi-model access
#    Get key: https://openrouter.ai/keys
#    Also accepted: OPENROUTERAI_API_KEY (legacy / Vercel dashboard variant)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# 3. Google Gemini — via OpenAI-compatible endpoint
#    Get key: https://aistudio.google.com/app/apikey
#    Also accepted: GMINI_API_KEY, GOOGLE_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 4. Mistral AI — mistral-large, codestral, mixtral…
#    Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# 5. Cohere — command-r family; strong multilingual support (Arabic, etc.)
#    Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# 6. xAI Grok
#    Get key: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# 7. AI71 Falcon — UAE / MENA sovereign AI platform
#    Get key: https://platform.ai71.ai
AI71_API_KEY=
AI71_MODEL=tiiuae/falcon-180b-chat

# 8. OpenAI or any OpenAI-compatible endpoint (Azure, Groq, Together, Ollama, vLLM…)
#    Get key: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# OpenAI-compatible alternatives (set OPENAI_BASE_URL + OPENAI_API_KEY):
#   Groq (fast + free tier): https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.3-70b-versatile
#   Together.ai:             https://api.together.xyz/v1
#   Ollama (local, no key):  http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Public canonical URL (used for metadata, sitemap, embed snippets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Security posture
# ---------------------------------------------------------------------------
# Set this in every deployed environment. It is also enabled automatically
# when DATABASE_URL or NEXT_PUBLIC_SUPABASE_URL is configured.
EIDON_REQUIRE_AUTH=true
# Never enable in production. This only allows the demo workspace to simulate
# already-approved tool actions for local demonstrations.
EIDON_ALLOW_DEMO_TOOL_APPROVAL=false
# Generate both values with a password manager or: openssl rand -base64 32
EIDON_OAUTH_STATE_SECRET=
EIDON_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional: Neon (serverless Postgres) — primary database.
# Create a project at https://neon.tech (free), copy the connection string.
# Apply neon/schema.sql in the SQL editor.
# Enables: workspaces, employees, conversations, messages, audit log.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Optional: Supabase — alternative to Neon.
# Create a project at https://supabase.com (free), run supabase/schema.sql.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
