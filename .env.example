# ---------------------------------------------------------------------------
# Eidon — environment
# Everything is optional. With no keys the app runs on the built-in
# deterministic demo engine, so local development and previews always work.
# ---------------------------------------------------------------------------

# Any OpenAI-compatible endpoint (OpenAI, Azure, Groq, Together, vLLM, Ollama…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Public canonical URL (used for metadata, sitemap, embed snippets)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: free-tier database (Supabase). Leave blank to run in demo mode.
# Create a project at https://supabase.com (free), then run supabase/schema.sql
# in the SQL editor. Enables workspaces, employees, conversations, audit log.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional: Neon (serverless Postgres) — alternative to Supabase.
# Create a project at https://neon.tech (free), copy the connection string.
# Apply neon/schema.sql in the SQL editor.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Optional: free-tier LLM providers (OpenAI-compatible). Examples:
#   Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
#   Together: https://api.together.xyz/v1
#   Ollama:   http://localhost:11434/v1   (local, no key)
# Leave OPENAI_API_KEY blank to use the built-in demo engine.
# ---------------------------------------------------------------------------
