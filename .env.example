# ---------------------------------------------------------------------------
# Eidon — environment
# Everything is optional. With no keys the app runs on the built-in
# deterministic demo engine, so local development and previews always work.
# ---------------------------------------------------------------------------

# Any OpenAI-compatible endpoint (OpenAI, Azure, Groq, Together, vLLM, Ollama…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Public canonical URL (used for metadata, sitemap, embed snippets)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
