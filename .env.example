# ---------------------------------------------------------------------------
# Eidon — environment
# Everything is optional. With no keys the app runs on the built-in
# deterministic demo engine, so local development and previews always work.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI provider — pick ONE. Anthropic is checked first, then OpenAI.
# ---------------------------------------------------------------------------

# Anthropic Claude (recommended for best performance)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI-compatible endpoint (OpenAI, Azure, Groq, Together, vLLM, Ollama…)
# Get key: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Alternative providers (OpenAI-compatible):
#   Groq (fast + free tier):  OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.3-70b-versatile
#   Together.ai:              OPENAI_BASE_URL=https://api.together.xyz/v1
#   Ollama (local, no key):   OPENAI_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Public canonical URL (used for metadata, sitemap, embed snippets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: Neon (serverless Postgres) — primary database.
# Create a project at https://neon.tech (free), copy the connection string.
# Apply neon/schema.sql in the SQL editor.
# Enables: workspaces, employees, conversations, messages, audit log.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Optional: Supabase — alternative to Neon.
# Create a project at https://supabase.com (free), run supabase/schema.sql.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
